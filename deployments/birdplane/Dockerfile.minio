# The official image and binary downloads for this release are unavailable.
# Build the same source release; do not change its version during cutover.
FROM golang:1.24-bookworm AS build
RUN git clone --depth 1 --branch RELEASE.2025-09-07T16-13-09Z https://github.com/minio/minio.git /src
WORKDIR /src
RUN test "$(git rev-parse HEAD)" = "07c3a429bfed433e49018cb0f78a52145d4bedeb"
RUN CGO_ENABLED=0 go build -trimpath -ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go 2025-09-07T16:13:09Z)" -o /minio .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata curl
COPY --from=build /minio /usr/bin/minio
ENTRYPOINT ["minio"]
